NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/rect-with-node
tokenSecretKey=replace-with-a-secure-secret
saltRounds=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:4000

# Cloudinary — used for retailer logo and product image uploads.
# Create a free account at https://cloudinary.com and copy these from your dashboard.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
